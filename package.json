{
  "name": "phone-mouse-client-tools",
  "private": true,
  "description": "Dev-only checks for the phone-mouse web client. Never needed to run the app.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/client/e2e/**'",
    "format:check": "prettier --check --no-error-on-unmatched-pattern src/phone_mouse/static tests/client",
    "format": "prettier --write src/phone_mouse/static tests/client",
    "check": "npm run typecheck && npm run test && npm run format:check",
    "e2e": "playwright test tests/client/e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
